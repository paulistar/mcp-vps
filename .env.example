# Porta HTTP do servidor
PORT=80

# Token de autenticação (obrigatório em produção)
# Envie no header: Authorization: Bearer <token>
MCP_AUTH_TOKEN=seu-token-seguro-aqui

# Timeout máximo por comando (ms)
EXEC_TIMEOUT_MS=30000

# Tamanho máximo de stdout/stderr/arquivos (bytes)
MAX_OUTPUT_BYTES=512000

# Diretório padrão para comandos shell
DEFAULT_CWD=/
